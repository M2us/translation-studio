{
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "kind": {
      "enum": [
        "audio",
        "images"
      ]
    },
    "sourceLanguage": {
      "type": "string",
      "minLength": 1
    },
    "languages": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 2,
      "uniqueItems": true
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "context": {
            "type": "string"
          },
          "comment": {
            "type": "string"
          },
          "assets": {
            "type": "object",
            "additionalProperties": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "previewPath": {
                      "type": "string",
                      "minLength": 1
                    },
                    "assetPath": {
                      "type": "string",
                      "minLength": 1
                    },
                    "derivedFromSha256": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    }
                  },
                  "required": [
                    "previewPath"
                  ],
                  "additionalProperties": false,
                  "dependentRequired": {
                    "derivedFromSha256": [
                      "assetPath"
                    ]
                  }
                },
                {
                  "type": "object",
                  "properties": {
                    "variants": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "previewPath": {
                            "type": "string",
                            "minLength": 1
                          },
                          "assetPath": {
                            "type": "string",
                            "minLength": 1
                          },
                          "derivedFromSha256": {
                            "type": "string",
                            "pattern": "^[a-f0-9]{64}$"
                          },
                          "id": {
                            "type": "string",
                            "minLength": 1
                          },
                          "label": {
                            "type": "string",
                            "minLength": 1
                          },
                          "comment": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "previewPath",
                          "id",
                          "label"
                        ],
                        "additionalProperties": false,
                        "dependentRequired": {
                          "derivedFromSha256": [
                            "assetPath"
                          ]
                        }
                      },
                      "minItems": 1
                    },
                    "selectedVariantId": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "variants",
                    "selectedVariantId"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "null"
                }
              ]
            },
            "propertyNames": {
              "type": "string",
              "minLength": 1
            }
          },
          "extensions": {
            "type": "object"
          }
        },
        "required": [
          "id",
          "label",
          "assets"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "extensions": {
      "type": "object"
    }
  },
  "required": [
    "schemaVersion",
    "kind",
    "sourceLanguage",
    "languages",
    "entries"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Translation Studio media (schema 1)"
}
