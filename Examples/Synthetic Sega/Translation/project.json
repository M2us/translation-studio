{
  "schemaVersion": 1,
  "projectId": "synthetic-sega",
  "name": "Synthetic Sega",
  "sourceLanguage": "en",
  "targetLanguages": [
    "ru"
  ],
  "tabs": [
    {
      "id": "text",
      "type": "text",
      "label": "Text",
      "labels": {
        "ru": "Текст",
        "en": "Text"
      },
      "datasetId": "main",
      "catalogPath": "Translation/Text/main.json",
      "defaultsByLanguage": {
        "ru": {
          "allowEmpty": false
        }
      }
    }
  ],
  "actions": [
    {
      "id": "build-patch",
      "label": "Rebuild patch",
      "labels": {
        "ru": "Пересобрать патч",
        "en": "Rebuild patch"
      },
      "kind": "build",
      "executable": "Tools/DemoBuilder.exe",
      "arguments": [
        "--language",
        "ru"
      ],
      "workingDirectory": ".",
      "requiresSaved": true,
      "requiresComplete": true,
      "datasetIds": [
        "main"
      ],
      "targetLanguage": "ru",
      "outputs": [
        "Builds/Patch"
      ]
    }
  ],
  "extensions": {
    "demoFormat": "sega"
  }
}
